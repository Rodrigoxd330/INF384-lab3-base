# Archivo de ejemplo. El repositorio no trae un .dockerignore funcional.
#
# Crear .dockerignore en la raiz del repositorio es parte del bloque A1
# de la guia. Definir su contenido es trabajo del alumno: el criterio es
# que el contexto de construccion no incluya nada que no necesite llegar
# a la imagen.
#
# Sintaxis: un patron por linea, con la misma forma que .gitignore.
# TODO

# Dependencias locales
node_modules

# Git
.git
.gitignore
.github

# Variables de entorno / secretos
.env
.env.*

# Tests y cobertura
test
coverage

README.md
jest.config.js
sonar-project.properties

# Docker
Dockerfile
docker-compose.yml
docker-compose.yaml

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / sistema operativo
.vscode
.idea
.DS_Store
Thumbs.db

# Infraestructura, si no es necesaria para ejecutar la app
infra

# Ejemplos o archivos auxiliares
.dockerignore.ejemplo